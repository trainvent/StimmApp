PROD_PROJECT_ID=
# Sender address verified in Brevo.
SMTP_MAIL=
# Copy the SMTP login from Brevo Settings > SMTP & API.
SMTP_USER=
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
# false enables STARTTLS (required by the mail transport).
SMTP_SECURE=false
# Store the Brevo SMTP key (not API key) in Firebase Secret Manager:
# firebase functions:secrets:set SMTP_PASSWORD --project dev
# firebase functions:secrets:set SMTP_PASSWORD --project prod
TEST_EMAIL=
TEST_CODE=
TEST_PASSWORD=
PID_VERIFIER_ORIGIN_URL=
