rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'service@trainvent.com';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasStateValue(data) {
      return data.keys().hasAny(['state']) &&
             data.state is string &&
             data.state.size() > 0;
    }

    function hasCountryCode(data) {
      return data.keys().hasAny(['countryCode']) &&
             data.countryCode is string &&
             data.countryCode.size() > 0;
    }

    function supportsStateScope(data) {
      return (hasCountryCode(data) && data.countryCode == 'DE') ||
             (!hasCountryCode(data) && hasStateValue(data));
    }

    function hasValidUserStateCountry(data) {
      // DE users (and legacy users with existing state but no countryCode)
      // may keep a non-empty state, but PID profiles are also valid without
      // one because the requested German PID address has no region claim.
      // Other countries must keep state empty/null/absent.
      return supportsStateScope(data)
        ? (!data.keys().hasAny(['state']) ||
           data.state == null ||
           data.state == '' ||
           hasStateValue(data))
        : (!data.keys().hasAny(['state']) || data.state == null || data.state == '');
    }

    function hasDisplayName(data) {
      return data.keys().hasAny(['displayName']) &&
             data.displayName is string &&
             data.displayName.size() > 0;
    }

    // Must mirror AppLimits.minUsernameLength and maxDisplayNameLength.
    function hasValidDisplayName(data) {
      return hasDisplayName(data) &&
             data.displayName.size() >= 6 &&
             data.displayName.size() <= 30;
    }

    function usernameClaimMatches(userId) {
      return request.resource.data.keys().hasAny(['usernameKey']) &&
             request.resource.data.usernameKey is string &&
             existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameKey)) &&
             getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameKey)).data.uid == userId &&
             getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameKey)).data.displayName == request.resource.data.displayName;
    }

    function hasValidUsernameOnCreate(userId) {
      return !hasDisplayName(request.resource.data) ||
             (hasValidDisplayName(request.resource.data) &&
              usernameClaimMatches(userId));
    }

    function hasValidUsernameOnUpdate(userId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName', 'usernameKey']) ||
             hasValidUsernameOnCreate(userId);
    }

    function verifiedIdentityFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'givenName',
        'surname',
        'dateOfBirth',
        'address',
        'town',
        'countryCode'
      ]);
    }

    function currentIdentityRevision() {
      return resource.data.keys().hasAny(['identityRevision']) &&
             resource.data.identityRevision is int
        ? resource.data.identityRevision
        : 0;
    }

    function serverVerificationEvidenceUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'gotVerifiedAt',
        'identityVerificationValidUntil',
        'identityVerificationPolicyVersion',
        'verifiedIdentityRevision',
        'identityVerificationVerifiedFields'
      ]);
    }

    function hasSafeVerificationOnCreate() {
      return (!request.resource.data.keys().hasAny(['isVerified']) ||
              request.resource.data.isVerified == null ||
              request.resource.data.isVerified == false) &&
             (!request.resource.data.keys().hasAny(['gotVerifiedAt']) ||
              request.resource.data.gotVerifiedAt == null) &&
             (!request.resource.data.keys().hasAny(['identityVerificationValidUntil']) ||
              request.resource.data.identityVerificationValidUntil == null) &&
             (!request.resource.data.keys().hasAny(['identityVerificationPolicyVersion']) ||
              request.resource.data.identityVerificationPolicyVersion == null) &&
             (!request.resource.data.keys().hasAny(['identityRevision']) ||
              request.resource.data.identityRevision == 0) &&
             (!request.resource.data.keys().hasAny(['verifiedIdentityRevision']) ||
              request.resource.data.verifiedIdentityRevision == null) &&
             (!request.resource.data.keys().hasAny(['identityVerificationVerifiedFields']) ||
              (request.resource.data.identityVerificationVerifiedFields is list &&
               request.resource.data.identityVerificationVerifiedFields.size() == 0));
    }

    function hasValidOwnerVerificationUpdate() {
      return verifiedIdentityFieldsChanged()
        ? request.resource.data.isVerified == false &&
          request.resource.data.identityRevision == currentIdentityRevision() + 1 &&
          serverVerificationEvidenceUnchanged()
        : !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'isVerified',
            'gotVerifiedAt',
            'identityVerificationValidUntil',
            'identityVerificationPolicyVersion',
            'identityRevision',
            'verifiedIdentityRevision',
            'identityVerificationVerifiedFields'
          ]);
    }

    // Petition publication and signing are authoritative PID-gated actions.
    // Keep this predicate aligned with pid-profile-v1 in the backend and app.
    function hasCurrentPidVerification() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == true &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.identityVerificationPolicyVersion == 'pid-profile-v1' &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.identityVerificationValidUntil is timestamp &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.identityVerificationValidUntil > request.time &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.identityRevision is int &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verifiedIdentityRevision ==
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.identityRevision;
    }

    function requesterSupportsStateScope() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             supportsStateScope(
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data
             );
    }

    function hasValidContentState(data) {
      // Outside DE scope, content cannot be state-scoped.
      return (requesterSupportsStateScope()
          ? true
          : (!data.keys().hasAny(['state']) || data.state == null || data.state == '')) &&
        hasValidContentScope(data);
    }

    function hasValidContentScope(data) {
      // Petition/poll subcollection writes do not carry form metadata.
      // Validate scope whenever this is a top-level content document.
      return !data.keys().hasAll(['title', 'createdBy']) ||
        (data.keys().hasAll(['scopeType', 'scopeKey']) &&
         data.scopeType is string &&
         data.scopeKey is string &&
         data.scopeKey.size() > 0 &&
         data.scopeType in [
           'global',
           'countryUnion',
           'continent',
           'country',
           'stateOrRegion',
           'city'
         ] &&
         (data.scopeType != 'countryUnion' ||
           (data.keys().hasAny(['scopeUnionCode']) &&
            data.scopeUnionCode in ['EU', 'UN'])) &&
         (!(data.scopeType in ['country', 'stateOrRegion', 'city']) ||
           hasCountryCode(data)) &&
         (data.scopeType != 'stateOrRegion' ||
           (data.keys().hasAny(['stateOrRegion']) &&
            data.stateOrRegion is string &&
            data.stateOrRegion.size() > 0)) &&
         (data.scopeType != 'city' ||
           (data.keys().hasAny(['town']) &&
            data.town is string &&
            data.town.size() > 0)));
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/pollGroups/$(groupId));
    }

    function groupDocAfter(groupId) {
      return getAfter(/databases/$(database)/documents/pollGroups/$(groupId));
    }

    function groupExists(groupId) {
      return exists(/databases/$(database)/documents/pollGroups/$(groupId));
    }

    function isPollGroupCreator(groupId) {
      return isAuthenticated() &&
             groupExists(groupId) &&
             groupDoc(groupId).data.createdBy == request.auth.uid;
    }

    function isPollGroupAdmin(groupId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/pollGroups/$(groupId)/members/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/pollGroups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    function isPollGroupCreatorAfter(groupId) {
      return isAuthenticated() &&
             groupDocAfter(groupId).data.createdBy == request.auth.uid;
    }

    function isPollGroupMember(groupId) {
      return isAuthenticated() &&
             groupExists(groupId) &&
             request.auth.uid in groupDoc(groupId).data.memberIds;
    }

    function isPollGroupMemberAfter(groupId) {
      return isAuthenticated() &&
             request.auth.uid in groupDocAfter(groupId).data.memberIds;
    }

    function canReadPollGroup(groupId) {
      return isAdmin() ||
             isPollGroupMember(groupId) ||
             (isAuthenticated() &&
              groupExists(groupId) &&
              groupDoc(groupId).data.accessMode != 'private');
    }

    function canSelfJoinPollGroup(groupId) {
      return isAuthenticated() &&
             groupExists(groupId) &&
             request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberIds']) &&
             request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
             request.auth.uid in request.resource.data.memberIds &&
             !(request.auth.uid in resource.data.memberIds);
    }

    function canSelfLeavePollGroup(groupId) {
      return isAuthenticated() &&
             groupExists(groupId) &&
             resource.data.createdBy != request.auth.uid &&
             request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberIds']) &&
             resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1 &&
             request.auth.uid in resource.data.memberIds &&
             !(request.auth.uid in request.resource.data.memberIds);
    }

    // --- Collection Rules ---

    // Server-only OpenID4VP state. Cloud Functions use the Admin SDK and bypass
    // these rules; no mobile, web, or Firebase-authenticated admin client may
    // read session ownership or state.
    match /pidVerificationSessions/{sessionId} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      // Main Profile: Public Read, Owner Write
      allow read: if true;
      allow create: if isAdmin() ||
                    (isOwner(userId) &&
                     hasValidUserStateCountry(request.resource.data) &&
                     hasValidUsernameOnCreate(userId) &&
                     hasSafeVerificationOnCreate());
      allow update: if isAdmin() ||
                    (isOwner(userId) &&
                     hasValidUserStateCountry(request.resource.data) &&
                     hasValidUsernameOnUpdate(userId) &&
                     hasValidOwnerVerificationUpdate());
      allow delete: if isAdmin() || isOwner(userId);

      match /blockedUsers/{blockedUserId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /groupAccessNotifications/{notificationId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
        allow create: if isAdmin() ||
                      isOwner(userId) ||
                      (isAuthenticated() &&
                       request.resource.data.groupId is string &&
                       request.resource.data.recipientUid == userId &&
                       (
                         (
                           groupDocAfter(request.resource.data.groupId).data.createdBy == request.auth.uid ||
                           request.resource.data.actorUid == request.auth.uid
                         )
                       ));
      }

      // Explicitly handle subcollections for history
      match /signedPetitions/{docId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create, update: if isAdmin() ||
                              (isOwner(userId) && hasCurrentPidVerification());
      }

      match /votedPolls/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /completedSurveys/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Catch-all for other subcollections (if any)
      match /{subcollection}/{document=**} {
        allow read, write: if (isOwner(userId) || isAdmin()) &&
                          !(subcollection in [
                            'signedPetitions',
                            'votedPolls',
                            'completedSurveys',
                            'blockedUsers',
                            'groupAccessNotifications'
                          ]);
      }
    }

    match /usernames/{usernameKey} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.displayName is string &&
                    request.resource.data.displayName.size() >= 6 &&
                    request.resource.data.displayName.size() <= 30;
      allow update: if isAuthenticated() &&
                    resource.data.uid == request.auth.uid &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.displayName is string &&
                    request.resource.data.displayName.size() >= 6 &&
                    request.resource.data.displayName.size() <= 30;
      allow delete: if isAdmin() ||
                    (isAuthenticated() &&
                     resource.data.uid == request.auth.uid &&
                     (
                       !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) ||
                       getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameKey != usernameKey
                     ));
    }

    // Petitions & Polls
    match /petitions/{petitionId} {
      allow read: if true;
      allow create: if isAdmin() ||
                    (hasCurrentPidVerification() &&
                     request.resource.data.createdBy == request.auth.uid &&
                     hasValidContentState(request.resource.data));
      allow update: if isAdmin() ||
                    (isAuthenticated() &&
                     hasValidContentState(request.resource.data) &&
                     (
                       (
                         resource.data.createdBy == request.auth.uid &&
                         !request.resource.data.diff(resource.data).affectedKeys()
                           .hasAny(['signatureCount'])
                       ) ||
                       (
                         hasCurrentPidVerification() &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['signatureCount']) &&
                         request.resource.data.signatureCount == resource.data.signatureCount + 1 &&
                         !exists(/databases/$(database)/documents/petitions/$(petitionId)/signatures/$(request.auth.uid)) &&
                         existsAfter(/databases/$(database)/documents/petitions/$(petitionId)/signatures/$(request.auth.uid))
                       ) ||
                       (
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['signatureCount']) &&
                         request.resource.data.signatureCount == resource.data.signatureCount - 1 &&
                         exists(/databases/$(database)/documents/petitions/$(petitionId)/signatures/$(request.auth.uid)) &&
                         !existsAfter(/databases/$(database)/documents/petitions/$(petitionId)/signatures/$(request.auth.uid))
                       )
                     ));
      allow delete: if isAdmin() ||
                    (isAuthenticated() &&
                     resource.data.createdBy == request.auth.uid);

      match /signatures/{signerId} {
        allow read: if true;
        allow create: if isAdmin() ||
                      (isOwner(signerId) &&
                       hasCurrentPidVerification() &&
                       request.resource.data.uid == request.auth.uid);
        allow update: if false;
        allow delete: if isAdmin() || isOwner(signerId);
      }
    }

    match /polls/{document=**} {
      allow read: if true;
      allow write: if isAdmin() ||
                    (isAuthenticated() && hasValidContentState(request.resource.data));
    }

    match /surveys/{surveyId} {
      allow read: if true;
      allow create: if isAdmin() ||
                    (isAuthenticated() &&
                     request.resource.data.createdBy == request.auth.uid &&
                     hasValidContentState(request.resource.data));
      allow update: if isAdmin() ||
                    (isAuthenticated() &&
                     resource.data.createdBy == request.auth.uid &&
                     hasValidContentState(request.resource.data)) ||
                    (isAuthenticated() &&
                     request.resource.data.diff(resource.data).changedKeys()
                       .hasOnly(['questionVotes', 'responseCount']) &&
                     !exists(/databases/$(database)/documents/surveys/$(surveyId)/responses/$(request.auth.uid)) &&
                     existsAfter(/databases/$(database)/documents/surveys/$(surveyId)/responses/$(request.auth.uid)));
      allow delete: if isAdmin() ||
                    (isAuthenticated() &&
                     resource.data.createdBy == request.auth.uid);

      match /responses/{uid} {
        allow read: if isAdmin() ||
                    isOwner(uid) ||
                    (isAuthenticated() &&
                     get(/databases/$(database)/documents/surveys/$(surveyId)).data.createdBy == request.auth.uid);
        allow create: if isOwner(uid) &&
                      !exists(/databases/$(database)/documents/surveys/$(surveyId)/responses/$(uid)) &&
                      request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin() || isOwner(uid);
      }
    }

    match /pollGroups/{groupId} {
      allow read: if isAdmin() ||
                   (isAuthenticated() &&
                    (
                      request.auth.uid in resource.data.memberIds ||
                      resource.data.createdBy == request.auth.uid ||
                      resource.data.accessMode != 'private'
                    ));
      allow create: if isAdmin();
      allow update: if isAdmin() ||
                    (isAuthenticated() &&
                     resource.data.createdBy == request.auth.uid) ||
                    isPollGroupAdmin(groupId) ||
                    canSelfJoinPollGroup(groupId) ||
                    canSelfLeavePollGroup(groupId);
      allow delete: if isAdmin() ||
                    (isAuthenticated() &&
                     resource.data.createdBy == request.auth.uid) ||
                    isPollGroupAdmin(groupId);

      match /members/{memberId} {
        allow read: if canReadPollGroup(groupId) ||
                    (isAuthenticated() && memberId == request.auth.uid);
        allow create: if isAdmin() ||
                      (isPollGroupCreatorAfter(groupId) &&
                       request.resource.data.joinedBy == request.auth.uid) ||
                      (isPollGroupMemberAfter(groupId) &&
                       memberId == request.auth.uid &&
                       request.resource.data.joinedBy == request.auth.uid);
        allow update: if isAdmin() ||
                      (((isPollGroupCreator(groupId) || isPollGroupAdmin(groupId)) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'role']) &&
                        request.resource.data.role in ['admin', 'manager', 'user'] &&
                        (memberId != groupDoc(groupId).data.createdBy ||
                         request.resource.data.role == 'admin')) ||
                       (isAuthenticated() &&
                        memberId == request.auth.uid &&
                        isPollGroupMember(groupId) &&
                        groupDoc(groupId).data.nicknameMode == 'self_named' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])));
        allow delete: if isAdmin() ||
                      isPollGroupCreator(groupId) ||
                      isPollGroupAdmin(groupId) ||
                      (isAuthenticated() &&
                       memberId == request.auth.uid &&
                       isPollGroupMember(groupId));
      }

      match /allowedMembers/{allowedMemberId} {
        allow read: if isAdmin() || isPollGroupCreator(groupId) || isPollGroupAdmin(groupId);
        allow create: if isAdmin() || isPollGroupCreatorAfter(groupId) || isPollGroupAdmin(groupId);
        allow update, delete: if isAdmin() || isPollGroupCreator(groupId) || isPollGroupAdmin(groupId);
      }

      match /allowedDomains/{allowedDomainId} {
        allow read: if isAdmin() || isPollGroupCreator(groupId) || isPollGroupAdmin(groupId);
        allow create: if isAdmin() || isPollGroupCreatorAfter(groupId) || isPollGroupAdmin(groupId);
        allow update, delete: if isAdmin() || isPollGroupCreator(groupId) || isPollGroupAdmin(groupId);
      }

      match /invitations/{invitationId} {
        allow read: if isAdmin() ||
                    isPollGroupCreator(groupId) ||
                    isPollGroupAdmin(groupId) ||
                    (isAuthenticated() &&
                     resource.data.recipientUid == request.auth.uid);
        allow create: if isAdmin() ||
                      isPollGroupCreatorAfter(groupId) ||
                      isPollGroupAdmin(groupId);
        allow update: if isAdmin() ||
                      isPollGroupCreator(groupId) ||
                      isPollGroupAdmin(groupId) ||
                      (isAuthenticated() &&
                       resource.data.recipientUid == request.auth.uid &&
                       request.resource.data.recipientUid == request.auth.uid &&
                       request.resource.data.diff(resource.data).changedKeys()
                         .hasOnly(['status', 'resolvedAt']) &&
                       request.resource.data.status in ['accepted', 'declined']);
        allow delete: if isAdmin() ||
                      isPollGroupCreator(groupId) ||
                      isPollGroupAdmin(groupId);
      }

      match /activities/{activityId} {
        allow read: if isAdmin() ||
                    isPollGroupCreator(groupId) ||
                    isPollGroupAdmin(groupId);
        allow create: if isAdmin() ||
                      (isAuthenticated() &&
                       request.resource.data.actorUid == request.auth.uid &&
                       request.resource.data.type in [
                         'member_joined',
                         'member_left',
                         'member_removed',
                         'ownership_transferred',
                         'admin_election_started',
                         'publication_published'
                       ] &&
                       request.resource.data.createdAt is timestamp &&
                       (isPollGroupMember(groupId) ||
                        isPollGroupMemberAfter(groupId)));
        allow update: if false;
        allow delete: if isAdmin() ||
                      ((isPollGroupCreator(groupId) ||
                        isPollGroupAdmin(groupId)) &&
                       !existsAfter(/databases/$(database)/documents/pollGroups/$(groupId)));
      }

      match /adminElections/{electionId} {
        allow read: if canReadPollGroup(groupId);
        allow create: if isAdmin() ||
                      isPollGroupCreatorAfter(groupId);
        allow update: if false;
        allow delete: if isAdmin() ||
                      isPollGroupCreator(groupId) ||
                      isPollGroupAdmin(groupId);

        match /votes/{voterUid} {
          allow read: if isAdmin() ||
                      isPollGroupCreator(groupId) ||
                      isPollGroupAdmin(groupId) ||
                      (isAuthenticated() && voterUid == request.auth.uid);
          allow create, update: if false;
          allow delete: if isAdmin() ||
                        isPollGroupCreator(groupId) ||
                        isPollGroupAdmin(groupId);
        }
      }
    }

    match /moderationReports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Verification Codes: Blocked
    match /verificationCodes/{document=**} {
      allow read, write: if false;
    }

    // Default Fallback
    match /{collection}/{document=**} {
      allow read, write: if isAdmin() &&
                         collection != 'pidVerificationSessions';
    }
  }
}
