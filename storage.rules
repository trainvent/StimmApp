rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
      // Allow each authenticated user to write/read their own profile image.
    	// Adjust `allow read` to `if request.auth != null` if you want to restrict reads to signed-in users.
    	match /users/{userId}/{fileName=**} {
      	// Allow reads publicly (change to `if request.auth != null && request.auth.uid == userId`
      	// or `if request.auth != null` to restrict).
      	allow read: if true;

      	// Allow upload/update/delete only by the authenticated owner
      	// and only for image files under 5 MB.
      	allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /groups/{groupId}/profile/{fileName} {
      function groupData() {
        return firestore.get(/databases/(default)/documents/pollGroups/$(groupId)).data;
      }
      function canManagePicture() {
        return request.auth != null &&
          (groupData().createdBy == request.auth.uid ||
           firestore.get(/databases/(default)/documents/pollGroups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin');
      }
      allow read: if request.auth != null &&
        (groupData().createdBy == request.auth.uid ||
         request.auth.uid in groupData().memberIds ||
         groupData().accessMode != 'private');
      allow create, update: if canManagePicture() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType == 'image/png';
      allow delete: if canManagePicture();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}